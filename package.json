{
  "name": "privet-concept",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "preview": "vite preview --host 0.0.0.0",
    "build:pages": "tsc -b && vite build --base=/privet-app/",
    "build:native": "tsc -b && vite build --mode native --base=./ --outDir dist-native",
    "sync:ios": "npm run build:native && cap sync ios",
    "test:shells": "node scripts/check-shells.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
